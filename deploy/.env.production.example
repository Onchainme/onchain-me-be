# ===========================================================================
# Production env template for the Hetzner CX22 deploy.
# Copy to deploy/.env.production and fill in every "<...>" placeholder.
#
# This file feeds:
#   - api / worker containers (read directly via env_file)
#   - frontend image build (NEXT_PUBLIC_API_BASE_URL is consumed as a build-arg)
#   - caddy container (DOMAIN, CADDY_ACME_EMAIL via environment)
# ===========================================================================

# ---- domain & TLS (used by Caddy) ----
DOMAIN=example.com
CADDY_ACME_EMAIL=admin@example.com

# ---- frontend build-arg (mirrors DOMAIN above) ----
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# ---- application ----
NODE_ENV=production
LOG_LEVEL=info
PORT=3001

# ---- Mongo (internal docker DNS) ----
# replicaSet=rs0 is required because the app uses multi-document transactions.
MONGODB_URI=mongodb://mongo:27017/onchainme?replicaSet=rs0

# ---- Redis (internal docker DNS) ----
REDIS_URL=redis://redis:6379

# ---- Auth ----
# Generate a fresh secret: openssl rand -base64 48
JWT_SECRET=<generate_with_openssl_rand_base64_48>
COOKIE_DOMAIN=example.com
FRONTEND_ORIGIN=https://app.example.com

# ---- Solana / Helius ----
# Start on devnet; flip to mainnet-beta later by changing these four lines and
# re-running `docker compose up -d` (no rebuild needed).
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Helius API key is optional on devnet (public RPC supports DAS), required on
# mainnet for getAssetsByOwner used by the import flow.
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=<random_string_for_webhook_signature>

# ---- Mint authority ----
# Base58-encoded ed25519 secret key (64 bytes after decode).
# Generate on the server:
#   solana-keygen new -o ~/.config/solana/onchainme-prod.json --no-bip39-passphrase
# then base58-encode the JSON array — see deploy/README.md.
# Fund the resulting pubkey with ~0.8 SOL (devnet airdrop or transfer) before
# creating the merkle tree.
MINT_AUTHORITY_PRIVATE_KEY=<base58_64_byte_secret>
# Created by deploy/README.md step "Create Merkle tree". Leave empty until then.
MERKLE_TREE_ADDRESS=<merkle_tree_pubkey>
# Optional collection NFT mint. Leave empty for tree-only (uncollected) mints.
COLLECTION_ADDRESS=
METADATA_BASE_URL=https://api.example.com/api/v1/metadata

# ---- Observability ----
# Sentry DSN: leave empty during alpha to avoid noise from devnet errors.
SENTRY_DSN=
SERVICE_VERSION=prod-001

# ---- Bull-Board admin (https://api.<DOMAIN>/admin/queues) ----
# Format: user:password. Generate password with: openssl rand -base64 24
ADMIN_BASIC_AUTH=admin:<generate_with_openssl_rand_base64_24>

# ---- Dev convenience flag ----
# Set to "true" on alpha/devnet deploys to expose POST /api/v1/dev/seed-eligibility[+all]
# (still require a logged-in session). Leave empty/false on mainnet.
ALLOW_DEV_ROUTES=false
